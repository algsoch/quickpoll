# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# For Azure PostgreSQL, use: postgresql+asyncpg://user:password@host.postgres.database.azure.com:5432/dbname?sslmode=require

# Application Settings
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# Server Settings
HOST=0.0.0.0
PORT=8000

# Admin Credentials (for admin endpoints)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
