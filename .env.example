# QuickPoll Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://quickpoll_user:your_password@localhost/quickpoll_db

# Security
SECRET_KEY=your-super-secret-key-at-least-32-characters-long-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development

# CORS - Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Server
HOST=0.0.0.0
PORT=8000

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# ==========================================
# GOOGLE OAUTH CONFIGURATION
# ==========================================
# Get these from: https://console.cloud.google.com/
# 1. Create a project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials
# 4. Copy the Client ID and Client Secret here

GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/users/auth/google/callback

# For production, use:
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/users/auth/google/callback
